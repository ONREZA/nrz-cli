{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONREZA Project Configuration",
  "description": "Configuration file for ONREZA platform projects (onreza.toml)",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "object",
      "description": "Project identity and platform binding",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Project ID on ONREZA platform",
          "pattern": "^proj_"
        },
        "name": {
          "type": "string",
          "description": "Project display name"
        },
        "workspace": {
          "type": "string",
          "description": "Workspace slug"
        },
        "framework": {
          "type": "string",
          "description": "Detected framework slug (auto-saved by nrz detect --save). Examples: next, nuxt, sveltekit, astro, vite, remix"
        }
      }
    },
    "dev": {
      "type": "object",
      "description": "Local development server settings",
      "additionalProperties": true,
      "properties": {
        "command": {
          "type": "string",
          "description": "Framework dev command (e.g. \"npm run dev\")"
        },
        "port": {
          "type": "integer",
          "description": "Port for the emulator HTTP server",
          "default": 4321,
          "minimum": 1,
          "maximum": 65535
        },
        "host": {
          "type": "string",
          "description": "Bind host for the emulator",
          "default": "127.0.0.1"
        },
        "data_dir": {
          "type": "string",
          "description": "Directory for local data (SQLite, KV)",
          "default": ".onreza/data"
        },
        "db_name": {
          "type": "string",
          "description": "SQLite database filename for D1 emulation",
          "default": "dev.db"
        },
        "aliases": {
          "type": "object",
          "description": "Named command profiles for nrz dev --alias <name>",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "description": "Build output settings",
      "additionalProperties": true,
      "properties": {
        "command": {
          "type": "string",
          "description": "Build command to run before deploy (e.g. \"npm run build\")"
        },
        "output_dirs": {
          "type": "array",
          "description": "Directories to search for build output",
          "items": {
            "type": "string"
          },
          "default": ["dist", ".output", "build", "out", "_site", "www", ".vitepress/dist"]
        }
      }
    },
    "deploy": {
      "type": "object",
      "description": "Deployment settings",
      "additionalProperties": true,
      "properties": {
        "skip_migrations": {
          "type": "boolean",
          "description": "Skip database migrations during deploy",
          "default": false
        },
        "compute": {
          "type": "string",
          "description": "Compute type override. If not set, inferred automatically from framework detection. Use when auto-detection is incorrect.",
          "enum": ["static", "isolate", "process"]
        },
        "entry": {
          "type": "string",
          "description": "Explicit entry point for PROCESS deployments (e.g. \"server.ts\", \"dist/index.js\"). Must be a relative path without '..'. If not set, resolved automatically: framework defaults > package.json 'main' > common fallbacks."
        }
      }
    },
    "migrations": {
      "type": "object",
      "description": "Database migration settings",
      "additionalProperties": true,
      "properties": {
        "dir": {
          "type": "string",
          "description": "Directory containing migration files",
          "default": "migrations"
        }
      }
    },
    "db": {
      "type": "object",
      "description": "Database settings",
      "additionalProperties": true,
      "properties": {
        "default_env": {
          "type": "string",
          "description": "Default environment for remote DB commands",
          "enum": ["production", "preview", "development"]
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Environment variable settings and declarations",
      "additionalProperties": false,
      "properties": {
        "strict": {
          "type": "boolean",
          "default": false,
          "description": "When true, nrz env push only uploads variables declared in [env.declarations]"
        },
        "declarations": {
          "type": "object",
          "description": "Environment variable declarations. Keys are variable names, values define visibility and requirements.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "enum": ["sensitive", "plain"],
                "description": "Shorthand: variable is required with the given visibility"
              },
              {
                "type": "object",
                "description": "Full declaration with visibility and optional required flag",
                "properties": {
                  "visibility": {
                    "type": "string",
                    "enum": ["sensitive", "plain"],
                    "description": "Whether the variable value should be encrypted on the platform"
                  },
                  "required": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the variable must be set before deploy"
                  }
                },
                "required": ["visibility"],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    }
  }
}
