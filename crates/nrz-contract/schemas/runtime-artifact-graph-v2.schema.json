{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.onreza.ru/schemas/runtime-artifact-graph-v2.schema.json",
  "title": "ONREZA Runtime Artifact Graph V2",
  "description": "Internal immutable contract for one application artifact, bounded dependency materializations, and declared runtime layer mounts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtimeArtifactGraph", "dependencyMaterializationManifest"],
  "properties": {
    "runtimeArtifactGraph": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "enum": ["RUNTIME_ARTIFACT_GRAPH_V2.0", "RUNTIME_ARTIFACT_GRAPH_V2.1", "RUNTIME_ARTIFACT_GRAPH_V2.2"],
          "type": "string"
        },
        "application": {
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "manifestDigest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "blobDescriptor": {
              "type": "object",
              "properties": {
                "mediaType": {
                  "const": "application/vnd.onreza.source-bundle.tar+zstd.v1",
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["mediaType", "digest", "size"],
              "additionalProperties": false
            }
          },
          "required": ["artifactId", "manifestDigest", "blobDescriptor"],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "materializationId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kind": {
                "enum": ["JAVASCRIPT_NODE_MODULES", "PYTHON_SITE_PACKAGES"],
                "type": "string"
              },
              "mountPoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "compatibility": {
                "type": "object",
                "properties": {
                  "runtimeFamily": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "runtimeVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "os": {
                    "const": "linux",
                    "type": "string"
                  },
                  "architecture": {
                    "enum": ["x86_64", "aarch64"],
                    "type": "string"
                  },
                  "libc": {
                    "enum": ["glibc", "musl"],
                    "type": "string"
                  },
                  "abi": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "packageManager": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "packageManagerVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "runnerRootfsDigest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "buildPolicyGeneration": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 2147483647,
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "runtimeFamily",
                  "runtimeVersion",
                  "os",
                  "architecture",
                  "libc",
                  "abi",
                  "packageManager",
                  "packageManagerVersion",
                  "runnerRootfsDigest",
                  "buildPolicyGeneration"
                ],
                "additionalProperties": false
              },
              "manifestDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "blobDescriptor": {
                "type": "object",
                "properties": {
                  "mediaType": {
                    "const": "application/vnd.onreza.dependency.erofs.v1",
                    "type": "string"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["mediaType", "digest", "size"],
                "additionalProperties": false
              }
            },
            "required": [
              "materializationId",
              "kind",
              "mountPoint",
              "compatibility",
              "manifestDigest",
              "blobDescriptor"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "runtimeLayers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "layerName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "applicationRoot": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "dependencyMaterializationIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "maxItems": 8
              },
              "dependencyBindings": {
                "type": "object",
                "properties": {
                  "mounts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "materializationId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "mountPoint": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      },
                      "required": ["materializationId", "mountPoint"],
                      "additionalProperties": false
                    },
                    "maxItems": 8
                  }
                },
                "required": ["mounts"],
                "additionalProperties": false
              },
              "entrypoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "launch": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string",
                    "pattern": "^(?:BUN|EXECUTABLE|NODE|CPYTHON|NODE_(?:0|[1-9][0-9]{0,8})|CPYTHON_(?:0|[1-9][0-9]{0,8})_(?:0|[1-9][0-9]{0,8}))$"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    },
                    "maxItems": 64
                  },
                  "cwd": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "readiness": {
                    "type": "object",
                    "properties": {
                      "protocol": {
                        "enum": ["TCP", "HTTP"],
                        "type": "string"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    },
                    "required": ["protocol"],
                    "additionalProperties": false
                  }
                },
                "required": ["profile", "args", "cwd"],
                "additionalProperties": false
              },
              "runtimeConfig": {
                "type": "object",
                "properties": {
                  "network": {
                    "type": "object",
                    "properties": {
                      "schemaVersion": {
                        "const": "COMPUTE_NETWORK_V1",
                        "type": "string"
                      },
                      "exposure": {
                        "enum": ["PUBLIC", "PRIVATE"],
                        "type": "string"
                      },
                      "ports": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                            },
                            "protocol": {
                              "enum": ["http", "grpc", "websocket", "tcp"],
                              "type": "string"
                            },
                            "port": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 65535
                            },
                            "binding": {
                              "enum": ["primary", "fixed"],
                              "type": "string"
                            }
                          },
                          "required": ["name", "protocol", "port", "binding"],
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 16
                      },
                      "readiness": {
                        "type": "object",
                        "properties": {
                          "protocol": {
                            "enum": ["tcp", "http"],
                            "type": "string"
                          },
                          "port": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64,
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
                          },
                          "path": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2048
                          }
                        },
                        "required": ["protocol", "port"],
                        "additionalProperties": false
                      },
                      "allowFrom": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "serviceId": {
                              "type": "string",
                              "format": "uuid",
                              "pattern": "^(?!00000000-0000-0000-0000-000000000000$)"
                            },
                            "layerName": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64,
                              "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$"
                            }
                          },
                          "required": ["serviceId", "layerName"],
                          "additionalProperties": false
                        },
                        "maxItems": 128
                      }
                    },
                    "required": ["schemaVersion", "exposure", "ports", "readiness", "allowFrom"],
                    "additionalProperties": false
                  },
                  "runtimeFamily": {
                    "enum": ["JAVASCRIPT", "PYTHON"],
                    "type": "string"
                  },
                  "runtimePolicyLineage": {
                    "type": "string",
                    "pattern": "^(BUN:CURRENT|NODE:[1-9][0-9]{0,8}|PYTHON:[1-9][0-9]{0,8}\\.(0|[1-9][0-9]{0,8}))$"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "exclusiveMinimum": 0
                  },
                  "memoryMb": {
                    "type": "integer",
                    "minimum": 32,
                    "maximum": 8192
                  },
                  "maxConcurrency": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 100,
                    "exclusiveMinimum": 0
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": ["layerName", "applicationRoot", "dependencyMaterializationIds", "entrypoint", "runtimeConfig"],
            "additionalProperties": false
          },
          "maxItems": 10
        },
        "graphDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["schemaVersion", "application", "dependencies", "runtimeLayers", "graphDigest"],
      "additionalProperties": false
    },
    "dependencyMaterializationManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "DEPENDENCY_MATERIALIZATION_V1.0",
          "type": "string"
        },
        "kind": {
          "enum": ["JAVASCRIPT_NODE_MODULES", "PYTHON_SITE_PACKAGES"],
          "type": "string"
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "runtimeFamily": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "runtimeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "os": {
              "const": "linux",
              "type": "string"
            },
            "architecture": {
              "enum": ["x86_64", "aarch64"],
              "type": "string"
            },
            "libc": {
              "enum": ["glibc", "musl"],
              "type": "string"
            },
            "abi": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "packageManager": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "packageManagerVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "runnerRootfsDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "buildPolicyGeneration": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 2147483647,
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "runtimeFamily",
            "runtimeVersion",
            "os",
            "architecture",
            "libc",
            "abi",
            "packageManager",
            "packageManagerVersion",
            "runnerRootfsDigest",
            "buildPolicyGeneration"
          ],
          "additionalProperties": false
        },
        "logicalTreeDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expandedFileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "expandedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "regularFileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "symlinkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "nativeObjectCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "canonicalizationPolicyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "generatorDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "blobDescriptor": {
          "type": "object",
          "properties": {
            "mediaType": {
              "const": "application/vnd.onreza.dependency.erofs.v1",
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mediaType", "digest", "size"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "compatibility",
        "logicalTreeDigest",
        "expandedFileCount",
        "expandedBytes",
        "regularFileCount",
        "symlinkCount",
        "nativeObjectCount",
        "canonicalizationPolicyDigest",
        "generatorDigest",
        "blobDescriptor"
      ],
      "additionalProperties": false
    }
  }
}
