+use proc_macro2::TokenStream;
+use quote::{ToTokens, format_ident, quote};
+
+use crate::generator::ast::{DeriveTrait, DerivesProvider, FieldDef, StructDef, StructKind};
+
+pub(crate) struct LiteralFieldsFragment<'a>(pub &'a StructDef);
+
+impl ToTokens for LiteralFieldsFragment<'_> {
+  fn to_tokens(&self, tokens: &mut TokenStream) {
+    for field in &self.0.fields {
+      LiteralFieldFragment::new(field, self.0).to_tokens(tokens);
+    }
+  }
+}
+
+pub(crate) struct LiteralFieldFragment<'a> {
+  field: &'a FieldDef,
+  parent: &'a StructDef,
+}
+
+impl<'a> LiteralFieldFragment<'a> {
+  pub(crate) fn new(field: &'a FieldDef, parent: &'a StructDef) -> Self {
+    Self { field, parent }
+  }
+
+  fn active(&self) -> bool {
+    self.field.const_value.is_some()
+      && !self.field.doc_hidden
+      && !matches!(self.parent.kind, StructKind::HeaderParams | StructKind::PathParams)
+  }
+
+  fn method(&self, prefix: &str) -> proc_macro2::Ident {
+    format_ident!("{}_const_{}", prefix, self.field.name.as_str().trim_start_matches("r#"))
+  }
+
+  pub(crate) fn attributes(&self) -> TokenStream {
+    if !self.active() {
+      return TokenStream::new();
+    }
+    let mut tokens = TokenStream::new();
+    let derives = self.parent.derives();
+    if derives.contains(&DeriveTrait::Deserialize) {
+      let path = format!("{}::{}", self.parent.name, self.method("deserialize"));
+      tokens.extend(quote! { #[serde(deserialize_with = #path)] });
+      if self.field.rust_type.nullable && !self.field.required_nullable && !self.field.rust_type.optional_nullable {
+        tokens.extend(quote! { #[serde(default)] });
+      }
+    }
+    if derives.contains(&DeriveTrait::Serialize) {
+      let path = format!("{}::{}", self.parent.name, self.method("serialize"));
+      tokens.extend(quote! { #[serde(serialize_with = #path)] });
+    }
+    tokens
+  }
+}
+
