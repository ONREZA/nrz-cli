new file mode 100644
index 0000000..c3dd42d
--- /dev/null
+++ b/crates/oas3-gen-support/src/present.rs
@@ -0,0 +1,25 @@
+use std::marker::PhantomData;
+
+use serde::{Deserializer, Serializer};
+use serde_with::{DeserializeAs, SerializeAs};
+
+/// Adapts a present property while preserving an explicitly null value.
+///
+/// Pair this adapter with a field default and omission of outer `None` values.
+/// The inner adapter may itself deserialize a nullable value.
+pub struct Present<A>(PhantomData<A>);
+
+impl<T, A: SerializeAs<T>> SerializeAs<Option<T>> for Present<A> {
+  fn serialize_as<S: Serializer>(source: &Option<T>, serializer: S) -> Result<S::Ok, S::Error> {
+    match source {
+      Some(value) => A::serialize_as(value, serializer),
+      None => serializer.serialize_none(),
+    }
+  }
+}
+
+impl<'de, T, A: DeserializeAs<'de, T>> DeserializeAs<'de, Option<T>> for Present<A> {
+  fn deserialize_as<D: Deserializer<'de>>(deserializer: D) -> Result<Option<T>, D::Error> {
+    A::deserialize_as(deserializer).map(Some)
+  }
+}
