@@ -0,0 +1,261 @@
+use std::{
+  io::{Read, Write},
+  net::TcpListener,
+};
+
+use serde_json::json;
+use validator::Validate as _;
+
+use crate::fixtures::wire_semantics::*;
+
+#[test]
+fn recursive_json_unions_preserve_nulls_in_arrays_and_maps() -> anyhow::Result<()> {
+  for value in [
+    json!(null),
+    json!([null, "text", true]),
+    json!({"nested": {"value": null}, "array": [null]}),
+  ] {
+    let parsed: ArbitraryJson = serde_json::from_value(value.clone())?;
+    assert_eq!(serde_json::to_value(parsed)?, value);
+  }
+  Ok(())
+}
+
+#[test]
+fn nullable_enums_keep_presence_and_reject_unknown_variants() -> anyhow::Result<()> {
+  for name in ["optionalEnum", "optionalTypedEnum"] {
+    for value in [json!(null), json!("INIT"), json!("BUILD")] {
+      let document = json!({"requiredNullable": null, "requiredBytes": null, name: value});
+      let parsed: WireDocument = serde_json::from_value(document.clone())?;
+      assert_eq!(serde_json::to_value(parsed)?, document);
+    }
+    assert!(
+      serde_json::from_value::<WireDocument>(json!({"requiredNullable": null, "requiredBytes": null, name: "UNKNOWN"}))
+        .is_err()
+    );
+  }
+  Ok(())
+}
+
+#[test]
+fn nullable_objects_and_arrays_keep_their_property_types() -> anyhow::Result<()> {
+  let valid = json!({
+    "requiredNullable": null, "requiredBytes": null,
+    "optionalObject": {"name": "nested"}, "optionalArray": [{"count": 2}]
+  });
+  let value: WireDocument = serde_json::from_value(valid.clone())?;
+  assert_eq!(value.optional_object.as_ref().unwrap().as_ref().unwrap().name, "nested");
+  assert_eq!(value.optional_array.as_ref().unwrap().as_ref().unwrap()[0].count, 2);
+  assert_eq!(serde_json::to_value(value)?, valid);
+  let invalid = json!({"requiredNullable": null, "requiredBytes": null, "optionalObject": {}});
+  assert!(serde_json::from_value::<WireDocument>(invalid).is_err());
+  Ok(())
+}
+
+#[test]
+fn bidirectional_models_support_cli_output_and_request_fixtures() -> anyhow::Result<()> {
+  let request: RequestOnly = serde_json::from_value(json!({"name": "example"}))?;
+  assert_eq!(request.name, "example");
+  assert_eq!(
+    serde_json::to_value(AcceptedResponse { accepted: true })?,
+    json!({"accepted": true})
+  );
+  Ok(())
+}
