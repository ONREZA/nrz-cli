+      assert!(!additional.is_required(), "{document}");
+      assert!(
+        !definition.serde_attrs.contains(&SerdeAttribute::DenyUnknownFields),
+        "{document}"
+      );
+    } else {
+      assert!(
+        definition.serde_attrs.contains(&SerdeAttribute::DenyUnknownFields),
+        "{document}"
+      );
+    }
+  }
+  Ok(())
+}
