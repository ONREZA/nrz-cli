+#[tokio::test]
+async fn raw_operations_preserve_http_evidence_and_encode_requests() -> anyhow::Result<()> {
+  for status in [200, 429, 599] {
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    let url = format!("http://{}", listener.local_addr()?);
+    let server = std::thread::spawn(move || -> std::io::Result<String> {
+      let (mut stream, _) = listener.accept()?;
+      stream.set_read_timeout(Some(std::time::Duration::from_secs(5)))?;
+      let mut bytes = Vec::new();
+      let mut buffer = [0; 4096];
+      loop {
+        let count = stream.read(&mut buffer)?;
+        if count == 0 {
+          break;
+        }
+        bytes.extend_from_slice(&buffer[..count]);
+        if let Some(end) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+          let headers = String::from_utf8_lossy(&bytes[..end]).to_lowercase();
+          let length = headers
+            .lines()
+            .find_map(|line| line.strip_prefix("content-length: "))
+            .and_then(|value| value.parse::<usize>().ok())
+            .unwrap_or(0);
+          if bytes.len() >= end + 4 + length {
+            break;
+          }
+        }
+      }
+      write!(
+        stream,
+        "HTTP/1.1 {status} Test\r\nRetry-After: 17\r\nContent-Length: 9\r\nConnection: close\r\n\r\nnot-json!"
+      )?;
+      Ok(String::from_utf8_lossy(&bytes).into_owned())
+    });
+    let http = reqwest::Client::builder()
+      .timeout(std::time::Duration::from_secs(5))
+      .build()?;
+    let client = WireClient::with_client(url, http)?;
+    let request = UpdateItemRequest {
+      path: UpdateItemRequestPath {
+        id: "a/b ?#".to_string(),
+      },
+      body: WireDocument {
+        optional_nullable: Some(None),
+        ..Default::default()
+      },
+    };
+    let response = client.raw().update_item(request).await?;
+    assert_eq!(response.status().as_u16(), status);
+    assert_eq!(response.headers()["retry-after"], "17");
+    assert_eq!(response.bytes().await?.as_ref(), b"not-json!");
+    let received = server.join().expect("HTTP fixture thread")?;
+    let (headers, body) = received.split_once("\r\n\r\n").expect("HTTP request");
+    assert!(
+      headers.starts_with("PATCH /items/a%2Fb%20%3F%23/ HTTP/1.1\r\n"),
+      "{headers}"
+    );
+    assert_eq!(
+      serde_json::from_str::<serde_json::Value>(body)?,
+      json!({
+        "requiredNullable": null, "requiredBytes": null, "optionalNullable": null
+      })
+    );
+  }
+  Ok(())
+}
