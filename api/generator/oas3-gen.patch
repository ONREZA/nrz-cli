+#[test]
+fn defaults_do_not_make_required_properties_optional() -> anyhow::Result<()> {
+  for input in [json!({}), json!({"required": "present"}), json!({"requiredDefault": 2})] {
+    assert!(
+      serde_json::from_value::<DefaultsModel>(input.clone()).is_err(),
+      "accepted {input}"
+    );
+  }
+  let model: DefaultsModel = serde_json::from_value(json!({"required": "present", "requiredDefault": 2}))?;
+  assert_eq!(model.required_default, 2);
+  assert!(model.optional_default.is_none());
+  let empty: DefaultsModel = serde_json::from_value(json!({"required": "", "requiredDefault": 2}))?;
+  empty.validate()?;
+  Ok(())
+}
