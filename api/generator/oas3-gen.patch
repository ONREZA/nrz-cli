diff --git a/crates/oas3-gen/src/tests/wire_semantics.rs b/crates/oas3-gen/src/tests/wire_semantics.rs
new file mode 100644
index 0000000..f22a84b
--- /dev/null
+++ b/crates/oas3-gen/src/tests/wire_semantics.rs
@@ -0,0 +1,291 @@
+use std::{
+  io::{Read, Write},
+  net::TcpListener,
+};
+
+use serde_json::json;
+use validator::Validate as _;
+
+use crate::fixtures::wire_semantics::*;
+
+#[test]
+fn recursive_json_unions_preserve_nulls_in_arrays_and_maps() -> anyhow::Result<()> {
+  for value in [
+    json!(null),
+    json!([null, "text", true]),
+    json!({"nested": {"value": null}, "array": [null]}),
+  ] {
+    let parsed: ArbitraryJson = serde_json::from_value(value.clone())?;
+    assert_eq!(serde_json::to_value(parsed)?, value);
+  }
+  Ok(())
+}
+
+#[test]
+fn nullable_enums_keep_presence_and_reject_unknown_variants() -> anyhow::Result<()> {
+  for name in ["optionalEnum", "optionalTypedEnum"] {
+    for value in [json!(null), json!("INIT"), json!("BUILD")] {
+      let document = json!({"requiredNullable": null, "requiredBytes": null, name: value});
+      let parsed: WireDocument = serde_json::from_value(document.clone())?;
+      assert_eq!(serde_json::to_value(parsed)?, document);
+    }
+    assert!(
+      serde_json::from_value::<WireDocument>(json!({"requiredNullable": null, "requiredBytes": null, name: "UNKNOWN"}))
+        .is_err()
+    );
+  }
+  Ok(())
+}
+
+#[test]
+fn nullable_objects_and_arrays_keep_their_property_types() -> anyhow::Result<()> {
+  let valid = json!({
+    "requiredNullable": null, "requiredBytes": null,
+    "optionalObject": {"name": "nested", "runtimeExtra": null},
+    "optionalArray": [{"count": 2, "runtimeExtra": [null, {"value": true}]}]
+  });
+  let value: WireDocument = serde_json::from_value(valid.clone())?;
+  assert_eq!(value.optional_object.as_ref().unwrap().as_ref().unwrap().name, "nested");
+  assert_eq!(value.optional_array.as_ref().unwrap().as_ref().unwrap()[0].count, 2);
+  assert_eq!(serde_json::to_value(value)?, valid);
+  let invalid = json!({"requiredNullable": null, "requiredBytes": null, "optionalObject": {}});
+  assert!(serde_json::from_value::<WireDocument>(invalid).is_err());
+  Ok(())
+}
+
+#[test]
+fn bidirectional_models_support_cli_output_and_request_fixtures() -> anyhow::Result<()> {
+  let request: RequestOnly = serde_json::from_value(json!({"name": "example"}))?;
+  assert_eq!(request.name, "example");
+  assert_eq!(
+    serde_json::to_value(AcceptedResponse {
+      accepted: true,
+      ..Default::default()
+    })?,
+    json!({"accepted": true})
+  );
+  Ok(())
+}
+
+#[test]
+fn default_open_objects_preserve_runtime_extensions() -> anyhow::Result<()> {
+  let value = json!({"name": "example", "runtimeExtra": {"values": [null, 3]}});
+  let request: RequestOnly = serde_json::from_value(value.clone())?;
+  assert_eq!(serde_json::to_value(request)?, value);
+  let value = json!({"accepted": true, "runtimeExtra": null});
+  let response: AcceptedResponse = serde_json::from_value(value.clone())?;
+  assert_eq!(serde_json::to_value(response)?, value);
+  Ok(())
+}
+
+#[test]
+fn closed_and_typed_objects_keep_additional_property_constraints() -> anyhow::Result<()> {
+  let value = json!({"known": "present"});
+  let closed: ClosedObject = serde_json::from_value(value.clone())?;
+  assert_eq!(serde_json::to_value(closed)?, value);
+  assert!(serde_json::from_value::<ClosedObject>(json!({"known": "present", "extra": "value"})).is_err());
+  let value = json!({"known": "present", "extra": "value"});
+  let typed: TypedOpenObject = serde_json::from_value(value.clone())?;
+  assert_eq!(serde_json::to_value(typed)?, value);
+  for extra in [json!(null), json!(5), json!({})] {
+    assert!(serde_json::from_value::<TypedOpenObject>(json!({"known": "present", "extra": extra})).is_err());
+  }
+  Ok(())
+}
+
+#[test]
+fn defaults_do_not_make_required_properties_optional() -> anyhow::Result<()> {
+  for input in [json!({}), json!({"required": "present"}), json!({"requiredDefault": 2})] {
+    assert!(
+      serde_json::from_value::<DefaultsModel>(input.clone()).is_err(),
+      "accepted {input}"
+    );
+  }
+  let model: DefaultsModel = serde_json::from_value(json!({"required": "present", "requiredDefault": 2}))?;
+  assert_eq!(model.required_default, 2);
+  assert!(model.optional_default.is_none());
+  let empty: DefaultsModel = serde_json::from_value(json!({"required": "", "requiredDefault": 2}))?;
+  empty.validate()?;
+  Ok(())
+}
+
+#[test]
+fn nullable_properties_preserve_presence_and_validate_values() -> anyhow::Result<()> {
+  let nulls = json!({"requiredNullable": null, "requiredBytes": null});
+  let mut value: WireDocument = serde_json::from_value(nulls.clone())?;
+  assert_eq!(serde_json::to_value(&value)?, nulls);
+  assert!(value.optional_nullable.is_none());
+
+  value.optional_nullable = Some(None);
+  value.optional_integer = Some(None);
+  value.optional_bytes = Some(None);
+  value.optional_union = Some(None);
+  let explicit_nulls = json!({
+    "requiredNullable": null, "requiredBytes": null,
+    "optionalNullable": null, "optionalInteger": null, "optionalBytes": null, "optionalUnion": null
+  });
+  assert_eq!(serde_json::to_value(&value)?, explicit_nulls);
+  assert_eq!(serde_json::from_value::<WireDocument>(explicit_nulls)?, value);
+  value.validate()?;
+
+  value.optional_nullable = Some(Some("hello".to_string()));
+  value.optional_integer = Some(Some(2));
+  value.optional_bytes = Some(Some(vec![104, 105]));
+  value.required_bytes = Some(vec![104, 105]);
+  let encoded = serde_json::to_value(&value)?;
+  assert_eq!(encoded["optionalBytes"], "aGk=");
+  assert_eq!(encoded["requiredBytes"], "aGk=");
+  assert_eq!(encoded["optionalNullable"], "hello");
+  assert_eq!(serde_json::from_value::<WireDocument>(encoded)?, value);
+  value.validate()?;
+  value.optional_nullable = Some(Some(String::new()));
+  assert!(value.validate().is_err());
+  value.optional_nullable = None;
+  value.optional_integer = Some(Some(0));
+  assert!(value.validate().is_err());
+
+  for missing in [
+    json!({}),
+    json!({"requiredNullable": null}),
+    json!({"requiredBytes": null}),
+  ] {
+    assert!(
+      serde_json::from_value::<WireDocument>(missing.clone()).is_err(),
+      "accepted {missing}"
+    );
+  }
+  Ok(())
+}
+
+#[tokio::test]
+async fn raw_operations_preserve_http_evidence_and_encode_requests() -> anyhow::Result<()> {
+  for status in [200, 429, 599] {
+    let listener = TcpListener::bind("127.0.0.1:0")?;
+    let url = format!("http://{}", listener.local_addr()?);
+    let server = std::thread::spawn(move || -> std::io::Result<String> {
+      let (mut stream, _) = listener.accept()?;
+      stream.set_read_timeout(Some(std::time::Duration::from_secs(5)))?;
+      let mut bytes = Vec::new();
+      let mut buffer = [0; 4096];
+      loop {
+        let count = stream.read(&mut buffer)?;
+        if count == 0 {
+          break;
+        }
+        bytes.extend_from_slice(&buffer[..count]);
+        if let Some(end) = bytes.windows(4).position(|part| part == b"\r\n\r\n") {
+          let headers = String::from_utf8_lossy(&bytes[..end]).to_lowercase();
+          let length = headers
+            .lines()
+            .find_map(|line| line.strip_prefix("content-length: "))
+            .and_then(|value| value.parse::<usize>().ok())
+            .unwrap_or(0);
+          if bytes.len() >= end + 4 + length {
+            break;
+          }
+        }
+      }
+      write!(
+        stream,
+        "HTTP/1.1 {status} Test\r\nRetry-After: 17\r\nContent-Length: 9\r\nConnection: close\r\n\r\nnot-json!"
+      )?;
+      Ok(String::from_utf8_lossy(&bytes).into_owned())
+    });
+    let http = reqwest::Client::builder()
+      .timeout(std::time::Duration::from_secs(5))
+      .build()?;
+    let client = WireClient::with_client(url, http)?;
+    let request = UpdateItemRequest {
+      path: UpdateItemRequestPath {
+        id: "a/b ?#".to_string(),
+      },
+      body: WireDocument {
+        optional_nullable: Some(None),
+        ..Default::default()
+      },
+    };
+    let response = client.raw().update_item(request).await?;
+    assert_eq!(response.status().as_u16(), status);
+    assert_eq!(response.headers()["retry-after"], "17");
+    assert_eq!(response.bytes().await?.as_ref(), b"not-json!");
+    let received = server.join().expect("HTTP fixture thread")?;
+    let (headers, body) = received.split_once("\r\n\r\n").expect("HTTP request");
+    assert!(
+      headers.starts_with("PATCH /items/a%2Fb%20%3F%23/ HTTP/1.1\r\n"),
+      "{headers}"
+    );
+    assert_eq!(
+      serde_json::from_str::<serde_json::Value>(body)?,
+      json!({
+        "requiredNullable": null, "requiredBytes": null, "optionalNullable": null
+      })
+    );
+  }
+  Ok(())
+}
+
+#[test]
+fn tuples_preserve_positional_types_and_exact_lengths() -> anyhow::Result<()> {
+  let value = json!({"headers":[["accept","application/json"]], "pair":["count",3], "single":[true]});
+  let document: TupleDocument = serde_json::from_value(value.clone())?;
+  assert_eq!(
+    document.headers[0],
+    ("accept".to_owned(), "application/json".to_owned())
+  );
+  assert_eq!(document.pair, ("count".to_owned(), 3));
+  assert_eq!(serde_json::to_value(document)?, value);
+  for header in [
+    json!([]),
+    json!(["name"]),
+    json!(["name", "value", "extra"]),
+    json!(["name", 5]),
+  ] {
+    assert!(serde_json::from_value::<TupleDocument>(json!({"headers":[header],"pair":["count",3]})).is_err());
+  }
+  assert!(serde_json::from_value::<TupleDocument>(json!({"headers":[],"pair":[3,"count"]})).is_err());
+  Ok(())
+}
+
+#[test]
+fn literal_fields_enforce_values_and_presence_in_both_directions() -> anyhow::Result<()> {
+  let value = json!({"kind":"ready","enabled":true,"count":1});
+  let parsed: LiteralDocument = serde_json::from_value(value.clone())?;
+  assert_eq!(
+    serde_json::to_value(&parsed)?,
+    json!({"kind":"ready","enabled":true,"count":1.0})
+  );
+  for (field, invalid) in [
+    ("kind", json!("other")),
+    ("enabled", json!(false)),
+    ("count", json!(2)),
+    ("optional", json!(null)),
+    ("optional", json!("other")),
+    ("nullable", json!(null)),
+  ] {
+    let mut document = value.clone();
+    document[field] = invalid;
+    assert!(serde_json::from_value::<LiteralDocument>(document).is_err(), "{field}");
+  }
+  let mut missing = value.clone();
+  missing.as_object_mut().expect("object").remove("kind");
+  assert!(serde_json::from_value::<LiteralDocument>(missing).is_err());
+  let mut changed = parsed;
+  changed.kind = "other".to_string();
+  assert!(serde_json::to_value(changed).is_err());
+  let nullable: LiteralDocument =
+    serde_json::from_value(json!({"kind":"ready","enabled":true,"count":1,"nullable":"fixed"}))?;
+  assert_eq!(serde_json::to_value(nullable)?["nullable"], "fixed");
+  Ok(())
+}
+
+#[test]
+fn untagged_object_unions_use_literal_fields_to_select_the_variant() -> anyhow::Result<()> {
+  for kind in ["accepted", "rejected"] {
+    let value = json!({"kind":kind,"id":1});
+    let parsed: LiteralUnion = serde_json::from_value(value.clone())?;
+    assert_eq!(serde_json::to_value(parsed)?, value);
+  }
+  assert!(serde_json::from_value::<LiteralUnion>(json!({"kind":"unknown","id":1})).is_err());
+  assert!(serde_json::from_value::<LiteralUnion>(json!({"id":1})).is_err());
+  Ok(())
+}
