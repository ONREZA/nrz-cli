+use proc_macro2::TokenStream;
+use quote::{ToTokens, format_ident, quote};
+
+use crate::generator::ast::{DeriveTrait, DerivesProvider, FieldDef, StructDef, StructKind};
+
+pub(crate) struct LiteralFieldsFragment<'a>(pub &'a StructDef);
+
+impl ToTokens for LiteralFieldsFragment<'_> {
+  fn to_tokens(&self, tokens: &mut TokenStream) {
+    for field in &self.0.fields {
+      LiteralFieldFragment::new(field, self.0).to_tokens(tokens);
+    }
+  }
+}
+
+pub(crate) struct LiteralFieldFragment<'a> {
+  field: &'a FieldDef,
+  parent: &'a StructDef,
+}
+
+impl<'a> LiteralFieldFragment<'a> {
+  pub(crate) fn new(field: &'a FieldDef, parent: &'a StructDef) -> Self {
+    Self { field, parent }
+  }
+
+  fn active(&self) -> bool {
+    self.field.const_value.is_some()
+      && !self.field.doc_hidden
+      && !matches!(self.parent.kind, StructKind::HeaderParams | StructKind::PathParams)
+  }
+
+  fn method(&self, prefix: &str) -> proc_macro2::Ident {
+    format_ident!("{}_const_{}", prefix, self.field.name.as_str().trim_start_matches("r#"))
+  }
+
+  pub(crate) fn attributes(&self) -> TokenStream {
+    if !self.active() {
+      return TokenStream::new();
+    }
+    let mut tokens = TokenStream::new();
+    let derives = self.parent.derives();
+    if derives.contains(&DeriveTrait::Deserialize) {
+      let path = format!("{}::{}", self.parent.name, self.method("deserialize"));
+      tokens.extend(quote! { #[serde(deserialize_with = #path)] });
+      if self.field.rust_type.nullable && !self.field.required_nullable && !self.field.rust_type.optional_nullable {
+        tokens.extend(quote! { #[serde(default)] });
+      }
+    }
+    if derives.contains(&DeriveTrait::Serialize) {
+      let path = format!("{}::{}", self.parent.name, self.method("serialize"));
+      tokens.extend(quote! { #[serde(serialize_with = #path)] });
+    }
+    tokens
+  }
+}
+
+impl ToTokens for LiteralFieldFragment<'_> {
+  fn to_tokens(&self, tokens: &mut TokenStream) {
+    if !self.active() {
+      return;
+    }
+    let literal = self.field.const_value.as_ref().expect("literal field").to_string();
+    let parent = &self.parent.name;
+    let rust_type = &self.field.rust_type;
+    let mut inner_type = rust_type.clone();
+    inner_type.optional_nullable = false;
+    let expected = if rust_type.optional_nullable {
+      quote! { Some(serde_json::from_str::<#inner_type>(#literal).map_err(serde::de::Error::custom)?) }
+    } else {
+      quote! { serde_json::from_str::<#rust_type>(#literal).map_err(serde::de::Error::custom)? }
+    };
+    let read = if rust_type.optional_nullable {
+      quote! { Some(<#inner_type as serde::Deserialize>::deserialize(deserializer)?) }
+    } else {
+      quote! { <#rust_type as serde::Deserialize>::deserialize(deserializer)? }
+    };
+    let derives = self.parent.derives();
+    let mut methods = TokenStream::new();
+    if derives.contains(&DeriveTrait::Deserialize) {
+      let name = self.method("deserialize");
+      methods.extend(quote! {
+        #[allow(clippy::float_cmp, reason = "JSON Schema constants require exact equality")]
+        fn #name<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<#rust_type, D::Error> {
+          let value = #read;
+          let expected: #rust_type = #expected;
+          if value != expected { return Err(serde::de::Error::custom("value does not match schema const")); }
+          Ok(value)
+        }
+      });
+    }
+    if derives.contains(&DeriveTrait::Serialize) {
+      let name = self.method("serialize");
+      let expected = if rust_type.optional_nullable {
+        quote! { Some(serde_json::from_str::<#inner_type>(#literal).map_err(serde::ser::Error::custom)?) }
+      } else {
+        quote! { serde_json::from_str::<#rust_type>(#literal).map_err(serde::ser::Error::custom)? }
+      };
+      methods.extend(quote! {
+        #[allow(clippy::ref_option, clippy::trivially_copy_pass_by_ref, reason = "serde field serializers receive a reference")]
+        #[allow(clippy::float_cmp, reason = "JSON Schema constants require exact equality")]
+        fn #name<S: serde::Serializer>(value: &#rust_type, serializer: S) -> Result<S::Ok, S::Error> {
