+#[test]
+fn tuples_preserve_positional_types_and_exact_lengths() -> anyhow::Result<()> {
+  let value = json!({"headers":[["accept","application/json"]], "pair":["count",3], "single":[true]});
+  let document: TupleDocument = serde_json::from_value(value.clone())?;
+  assert_eq!(
+    document.headers[0],
+    ("accept".to_owned(), "application/json".to_owned())
+  );
+  assert_eq!(document.pair, ("count".to_owned(), 3));
+  assert_eq!(serde_json::to_value(document)?, value);
+  for header in [
+    json!([]),
+    json!(["name"]),
+    json!(["name", "value", "extra"]),
+    json!(["name", 5]),
+  ] {
+    assert!(serde_json::from_value::<TupleDocument>(json!({"headers":[header],"pair":["count",3]})).is_err());
+  }
+  assert!(serde_json::from_value::<TupleDocument>(json!({"headers":[],"pair":[3,"count"]})).is_err());
+  Ok(())
+}
+
+#[test]
+fn literal_fields_enforce_values_and_presence_in_both_directions() -> anyhow::Result<()> {
+  let value = json!({"kind":"ready","enabled":true,"count":1});
+  let parsed: LiteralDocument = serde_json::from_value(value.clone())?;
+  assert_eq!(
+    serde_json::to_value(&parsed)?,
+    json!({"kind":"ready","enabled":true,"count":1.0})
+  );
+  for (field, invalid) in [
+    ("kind", json!("other")),
+    ("enabled", json!(false)),
+    ("count", json!(2)),
+    ("optional", json!(null)),
+    ("optional", json!("other")),
+    ("nullable", json!(null)),
+  ] {
+    let mut document = value.clone();
+    document[field] = invalid;
+    assert!(serde_json::from_value::<LiteralDocument>(document).is_err(), "{field}");
+  }
+  let mut missing = value.clone();
+  missing.as_object_mut().expect("object").remove("kind");
+  assert!(serde_json::from_value::<LiteralDocument>(missing).is_err());
+  let mut changed = parsed;
+  changed.kind = "other".to_string();
+  assert!(serde_json::to_value(changed).is_err());
+  let nullable: LiteralDocument =
+    serde_json::from_value(json!({"kind":"ready","enabled":true,"count":1,"nullable":"fixed"}))?;
+  assert_eq!(serde_json::to_value(nullable)?["nullable"], "fixed");
+  Ok(())
+}
+
+#[test]
+fn untagged_object_unions_use_literal_fields_to_select_the_variant() -> anyhow::Result<()> {
+  for kind in ["accepted", "rejected"] {
+    let value = json!({"kind":kind,"id":1});
+    let parsed: LiteralUnion = serde_json::from_value(value.clone())?;
+    assert_eq!(serde_json::to_value(parsed)?, value);
+  }
+  assert!(serde_json::from_value::<LiteralUnion>(json!({"kind":"unknown","id":1})).is_err());
+  assert!(serde_json::from_value::<LiteralUnion>(json!({"id":1})).is_err());
+  Ok(())
+}
