+    (Some(json!(true)), Some("indexmap::IndexMap<String, serde_json::Value>")),
+    (Some(json!({})), Some("indexmap::IndexMap<String, serde_json::Value>")),
+    (
+      Some(json!({"type": "string"})),
+      Some("indexmap::IndexMap<String, String>"),
+    ),
+    (Some(json!(false)), None),
+  ] {
+    let mut document = json!({
+      "type": "object",
+      "required": ["known"],
+      "properties": {"known": {"type": "string"}}
+    });
+    if let Some(additional) = additional {
+      document["additionalProperties"] = additional;
+    }
+    let schema = parse_schema(document.clone());
+    let graph = create_test_graph(BTreeMap::from([("Document".to_string(), schema)]));
+    let context = create_test_context(graph.clone(), default_config());
+    let converter = SchemaConverter::new(&context);
+    let types = converter.convert_schema("Document", graph.get("Document").unwrap())?;
+    let definition = types
+      .iter()
+      .find_map(|ty| match ty {
+        RustType::Struct(definition) => Some(definition),
+        _ => None,
+      })
+      .expect("object struct");
+    let additional = definition
+      .fields
+      .iter()
+      .find(|field| field.name == "additional_properties");
+
+    assert_eq!(
+      additional.map(|field| field.rust_type.to_rust_type()),
+      expected_type.map(str::to_owned),
+      "{document}"
+    );
+    if let Some(additional) = additional {
