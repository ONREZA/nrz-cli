+#[test]
+fn nullable_properties_preserve_presence_and_validate_values() -> anyhow::Result<()> {
+  let nulls = json!({"requiredNullable": null, "requiredBytes": null});
+  let mut value: WireDocument = serde_json::from_value(nulls.clone())?;
+  assert_eq!(serde_json::to_value(&value)?, nulls);
+  assert!(value.optional_nullable.is_none());
+
+  value.optional_nullable = Some(None);
+  value.optional_integer = Some(None);
+  value.optional_bytes = Some(None);
+  value.optional_union = Some(None);
+  let explicit_nulls = json!({
+    "requiredNullable": null, "requiredBytes": null,
+    "optionalNullable": null, "optionalInteger": null, "optionalBytes": null, "optionalUnion": null
+  });
+  assert_eq!(serde_json::to_value(&value)?, explicit_nulls);
+  assert_eq!(serde_json::from_value::<WireDocument>(explicit_nulls)?, value);
+  value.validate()?;
+
+  value.optional_nullable = Some(Some("hello".to_string()));
+  value.optional_integer = Some(Some(2));
+  value.optional_bytes = Some(Some(vec![104, 105]));
+  value.required_bytes = Some(vec![104, 105]);
+  let encoded = serde_json::to_value(&value)?;
+  assert_eq!(encoded["optionalBytes"], "aGk=");
+  assert_eq!(encoded["requiredBytes"], "aGk=");
+  assert_eq!(encoded["optionalNullable"], "hello");
+  assert_eq!(serde_json::from_value::<WireDocument>(encoded)?, value);
+  value.validate()?;
+  value.optional_nullable = Some(Some(String::new()));
+  assert!(value.validate().is_err());
+  value.optional_nullable = None;
+  value.optional_integer = Some(Some(0));
+  assert!(value.validate().is_err());
+
+  for missing in [
+    json!({}),
+    json!({"requiredNullable": null}),
+    json!({"requiredBytes": null}),
+  ] {
+    assert!(
+      serde_json::from_value::<WireDocument>(missing.clone()).is_err(),
+      "accepted {missing}"
+    );
+  }
+  Ok(())
+}
