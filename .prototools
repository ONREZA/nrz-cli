proto = "0.64.0"
moon = "2.6.5"
bun = "1.4.5"
rust = "1.100.0"
node = "24.22.3"
dagger = "0.21.12"
lefthook = "2.2.2"
actionlint = "1.7.12"

[settings]
auto-install = true

[tools.dagger]
plugin = "file://./.proto/plugins/dagger.toml"

[tools.lefthook]
plugin = "file://./.proto/plugins/lefthook.toml"

[tools.actionlint]
plugin = "file://./.proto/plugins/actionlint.toml"
