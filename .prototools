proto = "0.62.3"
moon = "2.5.5"
bun = "1.4.2"
rust = "1.98.1"
node = "24.12.0"
dagger = "0.21.9"
lefthook = "2.1.14"
actionlint = "1.7.12"

[settings]
auto-install = true

[tools.dagger]
plugin = "file://./.proto/plugins/dagger.toml"

[tools.lefthook]
plugin = "file://./.proto/plugins/lefthook.toml"

[tools.actionlint]
plugin = "file://./.proto/plugins/actionlint.toml"
