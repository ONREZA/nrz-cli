proto = "0.63.1"
moon = "2.6.2"
bun = "1.4.3"
rust = "1.99.1"
node = "24.22.1"
dagger = "0.21.10"
lefthook = "2.2.2"
actionlint = "1.7.12"

[settings]
auto-install = true

[tools.dagger]
plugin = "file://./.proto/plugins/dagger.toml"

[tools.lefthook]
plugin = "file://./.proto/plugins/lefthook.toml"

[tools.actionlint]
plugin = "file://./.proto/plugins/actionlint.toml"
